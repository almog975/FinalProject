FLASK_ENV=development
FLASK_APP=wsgi:app
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://shop:shop@postgres:5432/shopdb
# For local pytest without Postgres, leave DATABASE_URL unset (uses sqlite:///:memory:)

# Optional: directory where Jenkins/Syft/Trivy drop artifacts (sbom.json, scan-report.json).
# If unset or files missing, the API falls back to DB then bundled samples/.
# SECURITY_ARTIFACTS_DIR=/artifacts
