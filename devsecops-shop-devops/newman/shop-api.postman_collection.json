{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "DevSecOps Shop API",
    "description": "Phase 4 Newman smoke tests for shop API (health, products CRUD, cart, orders, security artifacts).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userId", "value": "newman-user" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "GET /ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('ready', function () { pm.expect(pm.response.json().status).to.eql('ready'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready"
          }
        }
      ]
    },
    {
      "name": "Products CRUD",
      "item": [
        {
          "name": "POST /api/products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('has id', function () { pm.expect(body.id).to.be.a('number'); });",
                  "pm.collectionVariables.set('productId', String(body.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Widget\",\n  \"description\": \"Created by Newman\",\n  \"price\": 12.5,\n  \"stock\": 20\n}"
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "GET /api/products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "PUT /api/products/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('updated name', function () { pm.expect(pm.response.json().name).to.eql('Newman Widget Pro'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Widget Pro\",\n  \"price\": 15.0,\n  \"stock\": 18\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "POST /api/cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('added 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('qty', function () { pm.expect(pm.response.json().quantity).to.eql(2); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"product_id\": {{productId}},\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "GET /api/cart/:userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('has items', function () { pm.expect(pm.response.json().item_count).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/cart/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /api/orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('placed 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('status placed', function () { pm.expect(body.status).to.eql('placed'); });",
                  "pm.collectionVariables.set('orderId', String(body.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "GET /api/orders/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('id match', function () {",
                  "  pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('orderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Security artifacts",
      "item": [
        {
          "name": "GET /api/security/sbom",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('kind sbom', function () { pm.expect(body.kind).to.eql('sbom'); });",
                  "pm.test('has artifact', function () { pm.expect(body.artifact).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/security/sbom"
          }
        },
        {
          "name": "GET /api/security/scan-report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('kind scan', function () { pm.expect(body.kind).to.eql('scan'); });",
                  "pm.test('has artifact', function () { pm.expect(body.artifact).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/security/scan-report"
          }
        }
      ]
    },
    {
      "name": "Cleanup product (optional)",
      "item": [
        {
          "name": "DELETE /api/products/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('deleted or gone', function () {",
                  "  pm.expect([204, 404]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        }
      ]
    }
  ]
}
