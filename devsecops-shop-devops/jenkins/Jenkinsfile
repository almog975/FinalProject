// Phase 4 — Declarative Jenkins pipeline for DevSecOps Shop (monorepo)
// Runs on a Kubernetes pod agent with tool sidecars (no tools required on JNLP).
// Requires Jenkins Kubernetes plugin + a configured cloud (Minikube Jenkins chart OK).
// Do NOT add a jnlp container here — the plugin injects it.
//
// Credentials / env:
//   GHCR_TOKEN or usernamePassword 'ghcr-creds'  — push to ghcr.io/almog975/shop-api
//   SONAR_HOST_URL, SONAR_TOKEN                   — SonarQube SAST (skip → unstable if unset)
//
// Hard gates (when tools run): gitleaks findings, Trivy CRITICAL (if image built),
// Checkov HIGH, pytest failure. See security/policies/README.md.

pipeline {
  agent {
    kubernetes {
      defaultContainer 'python'
      yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.11-slim
    command: [cat]
    tty: true
    resources:
      requests:
        cpu: "200m"
        memory: "512Mi"
      limits:
        memory: "1Gi"
  - name: gitleaks
    image: zricethezav/gitleaks:v8.18.4
    command: [cat]
    tty: true
  - name: checkov
    image: bridgecrew/checkov:3.2.257
    command: [cat]
    tty: true
  - name: trivy
    image: aquasec/trivy:0.56.2
    command: [cat]
    tty: true
  - name: helm
    image: alpine/helm:3.16.2
    command: [cat]
    tty: true
  - name: docker
    image: docker:27-cli
    command: [cat]
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
      type: Socket
'''
    }
  }

  options {
    // timestamps() requires the Timestamper plugin — omit for stock Jenkins.
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    APP_DIR        = 'devsecops-shop-app'
    DEVOPS_DIR     = 'devsecops-shop-devops'
    CHART_DIR      = 'devsecops-shop-devops/helm/shop'
    IMAGE_NAME     = 'shop-api'
    GHCR_IMAGE     = 'ghcr.io/almog975/shop-api'
    SBOM_FILE      = 'sbom.json'
    SCAN_REPORT    = 'scan-report.json'
    COVERAGE_MIN   = '70'
    DEPLOY_NS      = 'shop'
    DEPLOY_RELEASE = 'shop'
    IMAGE_BUILT    = 'false'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(
            script: 'git rev-parse --short HEAD',
            returnStdout: true
          ).trim()
          env.IMAGE_TAG = "${env.GIT_COMMIT_SHORT}"
          echo "Building ${IMAGE_NAME}:${IMAGE_TAG} (BUILD_NUMBER=${BUILD_NUMBER})"
        }
      }
    }

    stage('Lint') {
      steps {
        container('python') {
          dir("${APP_DIR}") {
            sh '''
              set -e
              python -m venv .venv-ci
              . .venv-ci/bin/activate
              pip install -q -U pip
              pip install -q -r requirements-dev.txt flake8
              flake8 app wsgi.py --max-line-length=100 --exclude=.venv,.venv-ci,__pycache__
            '''
          }
        }
        container('helm') {
          sh '''
            set -e
            helm lint "${CHART_DIR}"
            helm lint "${CHART_DIR}" -f "${CHART_DIR}/values-dev.yaml"
          '''
        }
      }
    }

    stage('Test') {
      steps {
        container('python') {
          dir("${APP_DIR}") {
            sh '''
              set -e
              . .venv-ci/bin/activate
              pip install -q -r requirements-dev.txt
              pytest -q --cov=app --cov-report=term-missing --cov-fail-under=${COVERAGE_MIN}
            '''
          }
        }
      }
    }

    stage('Secrets') {
      steps {
        container('gitleaks') {
          sh '''
            set -e
            gitleaks detect \
              --source . \
              --config "${DEVOPS_DIR}/security/.gitleaks.toml" \
              --report-path gitleaks-report.json \
              --report-format json \
              --verbose
          '''
        }
      }
    }

    stage('SAST') {
      steps {
        script {
          if (env.SONAR_HOST_URL?.trim()) {
            container('python') {
              sh '''
                set -e
                echo "ERROR: SONAR_HOST_URL is set but sonar-scanner is not bundled in this pod."
                echo "Install a sonar-scanner sidecar or unset SONAR_HOST_URL for student demos."
                exit 1
              '''
            }
          } else {
            echo 'WARN: SONAR_HOST_URL not set — skipping SonarQube SAST (not a silent pass)'
            unstable('SonarQube skipped — configure SONAR_HOST_URL / SONAR_TOKEN')
          }
        }
      }
    }

    stage('Build') {
      steps {
        script {
          def dockerOk = false
          container('docker') {
            dockerOk = sh(
              script: 'docker info >/dev/null 2>&1',
              returnStatus: true
            ) == 0
            if (dockerOk) {
              dir("${APP_DIR}") {
                sh '''
                  set -e
                  docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                    -t ${IMAGE_NAME}:phase2 \
                    .
                '''
              }
              env.IMAGE_BUILT = 'true'
              echo "Docker image built: ${IMAGE_NAME}:${IMAGE_TAG}"
            } else {
              echo 'WARN: docker info failed (no usable /var/run/docker.sock on this agent) — skipping Build/Trivy/Push'
              unstable('Docker socket unavailable — image build skipped')
              env.IMAGE_BUILT = 'false'
            }
          }
        }
      }
    }

    stage('Container scan') {
      when {
        expression { return env.IMAGE_BUILT == 'true' }
      }
      steps {
        container('trivy') {
          sh '''
            set -e
            trivy image --severity CRITICAL --exit-code 1 --ignore-unfixed \
              ${IMAGE_NAME}:${IMAGE_TAG}
            trivy image --format json --output ${SCAN_REPORT} \
              ${IMAGE_NAME}:${IMAGE_TAG} || true
          '''
        }
        container('python') {
          sh '''
            set -e
            if [ -f "${SCAN_REPORT}" ]; then
              python "${DEVOPS_DIR}/jenkins/scripts/summarize_trivy.py" \
                ${SCAN_REPORT} ${SCAN_REPORT}.summary.json \
                || cp ${SCAN_REPORT} ${SCAN_REPORT}.summary.json
            fi
          '''
        }
      }
    }

    stage('IaC scan') {
      steps {
        container('checkov') {
          sh '''
            set -e
            checkov -d "${CHART_DIR}" \
              --framework helm \
              --config-file "${DEVOPS_DIR}/security/.checkov.yaml" \
              --soft-fail-on LOW,MEDIUM \
              --hard-fail-on HIGH,CRITICAL \
              -o cli -o json \
              --output-file-path . \
              --compact
          '''
        }
      }
    }

    stage('SBOM') {
      steps {
        container('python') {
          sh '''
            set -e
            # syft not in the default pod — use pip-freeze / CycloneDX-ish fallback
            python "${DEVOPS_DIR}/jenkins/scripts/sbom_fallback.py" "${APP_DIR}" "${SBOM_FILE}"
            ls -la ${SBOM_FILE}
          '''
        }
      }
    }

    stage('Push') {
      when {
        expression { return env.IMAGE_BUILT == 'true' }
      }
      steps {
        script {
          def pushed = false
          try {
            withCredentials([
              usernamePassword(
                credentialsId: 'ghcr-creds',
                usernameVariable: 'GHCR_USER',
                passwordVariable: 'GHCR_PASS'
              )
            ]) {
              container('docker') {
                sh '''
                  set -e
                  echo "${GHCR_PASS}" | docker login ghcr.io -u "${GHCR_USER}" --password-stdin
                  docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${GHCR_IMAGE}:${IMAGE_TAG}
                  docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${GHCR_IMAGE}:${BUILD_NUMBER}
                  docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${GHCR_IMAGE}:phase2
                  docker push ${GHCR_IMAGE}:${IMAGE_TAG}
                  docker push ${GHCR_IMAGE}:${BUILD_NUMBER}
                  docker push ${GHCR_IMAGE}:phase2
                '''
              }
              pushed = true
            }
          } catch (ignored) {
            echo "INFO: Jenkins credential 'ghcr-creds' not available — trying GHCR_TOKEN env"
          }
          if (!pushed && env.GHCR_TOKEN?.trim()) {
            container('docker') {
              sh '''
                set -e
                echo "${GHCR_TOKEN}" | docker login ghcr.io -u "${GHCR_USER:-almog975}" --password-stdin
                docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${GHCR_IMAGE}:${IMAGE_TAG}
                docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${GHCR_IMAGE}:${BUILD_NUMBER}
                docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${GHCR_IMAGE}:phase2
                docker push ${GHCR_IMAGE}:${IMAGE_TAG}
                docker push ${GHCR_IMAGE}:${BUILD_NUMBER}
                docker push ${GHCR_IMAGE}:phase2
              '''
            }
            pushed = true
          }
          if (!pushed) {
            echo 'WARN: GHCR credentials not configured (ghcr-creds / GHCR_TOKEN) — skipping push'
          }
        }
      }
    }

    stage('Deploy (dev)') {
      steps {
        container('helm') {
          script {
            // In-cluster SA: try a cheap helm list; skip if API unreachable.
            def kubeOk = sh(
              script: 'helm list -A >/dev/null 2>&1',
              returnStatus: true
            ) == 0
            if (kubeOk) {
              sh '''
                set -e
                helm upgrade --install ${DEPLOY_RELEASE} ${CHART_DIR} \
                  -f ${CHART_DIR}/values-dev.yaml \
                  -n ${DEPLOY_NS} --create-namespace \
                  --set api.image.repository=${IMAGE_NAME} \
                  --set api.image.tag=${IMAGE_TAG} \
                  --wait --timeout 5m || \
                helm upgrade --install ${DEPLOY_RELEASE} ${CHART_DIR} \
                  -f ${CHART_DIR}/values-dev.yaml \
                  -n ${DEPLOY_NS} --create-namespace \
                  --set api.image.repository=${IMAGE_NAME} \
                  --set api.image.tag=${IMAGE_TAG} \
                  --timeout 5m
              '''
            } else {
              echo 'WARN: cluster API not reachable from helm container — skipping Deploy (dev)'
            }
          }
        }
      }
    }

    stage('Verify') {
      steps {
        container('helm') {
          sh '''
            set -e
            COLLECTION="${DEVOPS_DIR}/newman/shop-api.postman_collection.json"
            echo "helm template smoke verify (Newman needs a live URL — run manually when API is up)"
            helm template ${DEPLOY_RELEASE} ${CHART_DIR} \
              -f ${CHART_DIR}/values-dev.yaml \
              -n ${DEPLOY_NS} > /tmp/helm-smoke.yaml
            grep -q "kind: Deployment" /tmp/helm-smoke.yaml
            echo "helm template smoke OK ($(wc -l < /tmp/helm-smoke.yaml) lines)"
            echo "Newman collection present at ${COLLECTION}"
          '''
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'sbom.json,scan-report.json,scan-report.json.summary.json,gitleaks-report.json,results_*.json',
                       allowEmptyArchive: true
    }
    success {
      echo "Pipeline succeeded — image ${IMAGE_NAME}:${IMAGE_TAG} (IMAGE_BUILT=${IMAGE_BUILT})"
    }
    unstable {
      echo 'Pipeline UNSTABLE (e.g. SonarQube skipped and/or Docker socket missing). Hard gates for stages that ran still passed.'
    }
    failure {
      echo 'Pipeline FAILED — check hard gates: secrets / Trivy CRITICAL / Checkov HIGH / pytest'
    }
  }
}
