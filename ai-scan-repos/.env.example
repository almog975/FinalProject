# Copy to .env (never commit .env). In Kubernetes these become Secrets created from the CLI.
INTERNAL_API_TOKEN=change-me-long-random
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AI_KEYS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=aiscan-dev
# AI: openai_compatible (LM Studio/Ollama/vLLM) | openai | anthropic | gemini | grok | none
AI_PROVIDER=none
AI_MODEL=local-model
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_API_KEY=

# --- Gateway (Phase 2) ---
# GitHub OAuth App: callback URL = http://localhost:8080/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Optional comma-separated allowlist / admins (GitHub logins)
ALLOWED_GITHUB_LOGINS=
ADMIN_GITHUB_LOGINS=
WEBHOOK_AUTO_REVIEW=false
