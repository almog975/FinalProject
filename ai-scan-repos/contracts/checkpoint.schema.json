{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/almog975/FinalProject/ai-scan-repos/contracts/checkpoint.schema.json",
  "title": "checkpoint.json (v1) – written tmp -> fsync -> rename after every file",
  "type": "object",
  "required": [
    "schema",
    "review_id",
    "attempt",
    "budget_no",
    "stage",
    "progress",
    "cursor",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "checkpoint/v1"
    },
    "review_id": {
      "type": "string",
      "format": "uuid"
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "depth": {
      "$ref": "common.schema.json#/$defs/depth"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "budget_no": {
      "type": "integer",
      "minimum": 1,
      "description": "retry budget number; starts at 1, +1 per POST /reviews/{id}/retry"
    },
    "stage": {
      "enum": [
        "start",
        "clone",
        "scanners",
        "semgrep",
        "gitleaks",
        "trivy",
        "ai",
        "ai_analysis",
        "report",
        "done"
      ],
      "description": "resume stage (superset of progress stage)"
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "cursor": {
      "type": "object",
      "description": "resume position",
      "properties": {
        "scanners_done": {
          "type": "array",
          "items": {
            "enum": [
              "semgrep",
              "gitleaks",
              "trivy"
            ]
          }
        },
        "files_total": {
          "type": "integer",
          "minimum": 0
        },
        "files_done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings_offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
