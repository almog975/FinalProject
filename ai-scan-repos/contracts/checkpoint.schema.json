{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/almog975/FinalProject/ai-scan-repos/contracts/checkpoint.schema.json",
  "title": "checkpoint.json (v1) – written tmp -> fsync -> rename after every file",
  "type": "object",
  "required": ["schema", "review_id", "attempt", "budget_no", "stage", "progress", "cursor", "updated_at"],
  "properties": {
    "schema": {"const": "checkpoint/v1"},
    "review_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "commit_sha": {"$ref": "common.schema.json#/$defs/commit_sha"},
    "depth": {"$ref": "common.schema.json#/$defs/depth"},
    "attempt": {"$ref": "common.schema.json#/$defs/attempt"},
    "budget_no": {"$ref": "common.schema.json#/$defs/budget_no"},
    "stage": {"$ref": "common.schema.json#/$defs/stage"},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "cursor": {
      "type": "object", "description": "resume position",
      "properties": {
        "scanners_done": {"type": "array", "items": {"enum": ["semgrep", "gitleaks", "trivy"]}},
        "files_total": {"type": "integer", "minimum": 0},
        "files_done": {"type": "array", "items": {"type": "string"}},
        "findings_offset": {"type": "integer", "minimum": 0}
      }
    },
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
